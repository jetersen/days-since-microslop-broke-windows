---
import { severityLabels } from "@/lib/incidents";

interface Props {
  title: string;
  date: Date;
  kb?: string;
  severity: "annoyance" | "broken" | "catastrophic";
  affected: string[];
  fixed: boolean;
  fixDate?: Date;
  sources?: string[];
  href?: string;
  sourceLabels?: string[];
}

const {
  title,
  date,
  kb,
  severity,
  affected,
  fixed,
  fixDate,
  sources,
  href,
  sourceLabels,
} = Astro.props;

const dateStr = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const fixDateStr = fixDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="card incident-surface severity-accent" data-severity={severity}>
  <div class="card-header">
    <div class="card-meta">
      <time datetime={date.toISOString().split("T")[0]}>{dateStr}</time>
      {kb && <span class="kb">{kb}</span>}
      <span class="incident-chip incident-label severity-badge">{severityLabels[severity]}</span>
    </div>
    <h2 class="card-title">
      {href ? <a class="incident-title-link" href={href}>{title}</a> : title}
    </h2>
    <div class="incident-tags">
      {affected.map((tag) => <span class="incident-chip incident-tag">{tag}</span>)}
      {fixed
        ? <span class="incident-chip status-badge" data-status="fixed" title={fixDateStr ? `Fixed ${fixDateStr}` : undefined}>Fixed</span>
        : <span class="incident-chip status-badge" data-status="unfixed">Unfixed</span>
      }
    </div>
  </div>
  {href ? (
    <a class="details-link" href={href}>Full incident, fix status, and sources &rarr;</a>
  ) : (
    <details>
      <summary>Details</summary>
      <div class="card-body">
        <slot />
        {sources && sources.length > 0 && (
          <ul class="sources">
            {sources.map((url, index) => (
              <li><a href={url} target="_blank" rel="noopener noreferrer">{sourceLabels?.[index] ?? new URL(url).hostname}</a></li>
            ))}
          </ul>
        )}
      </div>
    </details>
  )}
</article>

<style>
  .card {
    padding: 1.25rem;
    transition: border-color 0.2s;
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .kb {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  details {
    margin-top: 0.75rem;
  }

  summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--color-link);
    user-select: none;
  }

  summary:hover {
    text-decoration: underline;
  }

  .details-link {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--color-link);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .details-link:hover {
    text-decoration: underline;
  }

  .card-body {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .card-body :global(p) {
    margin-bottom: 0.75rem;
  }

  .card-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .card-body :global(a) {
    color: var(--color-link);
  }

  .sources {
    list-style: none;
    padding: 0;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
  }

  .sources::before {
    content: "Sources:";
    font-weight: 600;
    color: var(--text-muted);
    width: 100%;
  }

  .sources a {
    color: var(--color-link);
    text-decoration: none;
  }

  .sources a:hover {
    text-decoration: underline;
  }
</style>
