---
interface Props {
  title: string;
  date: Date;
  kb?: string;
  severity: "annoyance" | "broken" | "catastrophic";
  affected: string[];
  fixed: boolean;
  fixDate?: Date;
  body: string;
  id: string;
}

const { title, date, kb, severity, affected, fixed, fixDate, body, id } = Astro.props;

const severityLabels = {
  annoyance: "Annoyance",
  broken: "Broken",
  catastrophic: "Catastrophic",
};

const dateStr = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const fixDateStr = fixDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class={`card severity-${severity}`}>
  <div class="card-header">
    <div class="card-meta">
      <time datetime={date.toISOString().split("T")[0]}>{dateStr}</time>
      {kb && <span class="kb">{kb}</span>}
      <span class={`badge severity-${severity}`}>{severityLabels[severity]}</span>
    </div>
    <h3 class="card-title">{title}</h3>
    <div class="tags">
      {affected.map((tag) => <span class="tag">{tag}</span>)}
      {fixed
        ? <span class="tag tag-fixed" title={fixDateStr ? `Fixed ${fixDateStr}` : undefined}>Fixed</span>
        : <span class="tag tag-unfixed">Unfixed</span>
      }
    </div>
  </div>
  <details>
    <summary>Details</summary>
    <div class="card-body">
      <Fragment set:html={body} />
    </div>
  </details>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--bg-card);
    border-left: 4px solid transparent;
    transition: border-color 0.2s;
  }

  .card.severity-annoyance {
    border-left-color: var(--color-annoyance);
  }

  .card.severity-broken {
    border-left-color: var(--color-broken);
  }

  .card.severity-catastrophic {
    border-left-color: var(--color-catastrophic);
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .kb {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .badge {
    display: inline-block;
    padding: 0.1em 0.5em;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge.severity-annoyance {
    background: var(--color-annoyance-bg);
    color: var(--color-annoyance);
  }

  .badge.severity-broken {
    background: var(--color-broken-bg);
    color: var(--color-broken);
  }

  .badge.severity-catastrophic {
    background: var(--color-catastrophic-bg);
    color: var(--color-catastrophic);
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    display: inline-block;
    padding: 0.1em 0.5em;
    border-radius: 4px;
    font-size: 0.75rem;
    background: var(--border-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .tag-fixed {
    background: var(--color-safe-bg);
    color: var(--color-safe);
    border-color: var(--color-safe);
  }

  .tag-unfixed {
    background: var(--color-danger-bg);
    color: var(--color-danger);
    border-color: var(--color-danger);
  }

  details {
    margin-top: 0.75rem;
  }

  summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--color-link);
    user-select: none;
  }

  summary:hover {
    text-decoration: underline;
  }

  .card-body {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .card-body :global(p) {
    margin-bottom: 0.75rem;
  }

  .card-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .card-body :global(a) {
    color: var(--color-link);
  }
</style>
