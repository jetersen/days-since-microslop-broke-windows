---
import type { CollectionEntry } from "astro:content";
import { incidentPath, severityLabels } from "@/lib/incidents";
import { taxonomySlug } from "@/lib/taxonomies";
import { archivePath } from "@/links";

interface Props {
  incidents: CollectionEntry<"incidents">[];
  linkedAffected: string[];
}

const { incidents, linkedAffected } = Astro.props;
const affectedLinks = new Set(linkedAffected);

---

<ol class="incident-list">
  {incidents.map((incident) => {
    const { data } = incident;
    const date = data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });

    return (
      <li class="incident incident-surface severity-accent" data-severity={data.severity}>
        <article>
          <div class="meta">
            <time datetime={data.date.toISOString().slice(0, 10)}>{date}</time>
            {data.kb && <span>{data.kb}</span>}
            <span class="compact-chip incident-chip incident-label severity-badge">
              {severityLabels[data.severity]}
            </span>
            <span
              class="compact-chip incident-chip incident-label status-badge"
              data-status={data.fixed ? "fixed" : "unfixed"}
            >
              {data.fixed ? "Fixed" : "Unfixed"}
            </span>
          </div>
          <h2><a class="incident-title-link" href={incidentPath(incident)}>{data.title}</a></h2>
          <ul class="tags incident-tags" aria-label="Affected components">
            {data.affected.map((tag) => {
              const slug = taxonomySlug(tag);
              return (
                <li>
                  {affectedLinks.has(slug)
                    ? <a class="incident-chip incident-tag" href={archivePath(`affected/${slug}`)}>{tag}</a>
                    : <span class="incident-chip incident-tag">{tag}</span>}
                </li>
              );
            })}
          </ul>
        </article>
      </li>
    );
  })}
</ol>

<style>
  .incident-list {
    list-style: none;
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
  }

  .incident {
    padding: 1rem 1.1rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .compact-chip {
    padding: 0.08rem 0.4rem;
    font-size: 0.68rem;
  }

  h2 {
    margin: 0.55rem 0 0;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .tags {
    list-style: none;
    margin: 0.65rem 0 0;
    padding: 0;
  }

  .tags a,
  .tags span {
    font-size: 0.72rem;
  }
</style>
