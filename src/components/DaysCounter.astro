    --ring-color: hsl(var(--hue) 70% 45%);
    --ring-bg: hsl(var(--hue) 60% 96%);
    --ring-glow: hsl(var(--hue) 60% 80%);
    --ring-border: hsl(var(--hue) 50% 70% / 0.25);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    flex: 1;
    padding: 2rem;
    gap: 6rem;
  }

  @media (prefers-color-scheme: dark) {
    .page {
      --ring-color: hsl(var(--hue) 75% 65%);
      --ring-bg: hsl(var(--hue) 40% 8%);
      --ring-glow: hsl(var(--hue) 50% 25%);
      --ring-border: hsl(var(--hue) 50% 40% / 0.3);
    }
  }

  .counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5rem;
  }

  .title {
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .number-ring {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(10rem, 28vw, 22rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ring-bg);
    box-shadow:
      0 0 0 1px var(--ring-border),
      0 0 80px -20px var(--ring-glow);
  }

  .page.broken .number-ring {
    animation: ring-pulse 2s ease-in-out infinite;
  }

  @keyframes ring-pulse {
    0%, 100% {
      box-shadow:
        0 0 0 1px var(--ring-border),
        0 0 40px -20px var(--ring-glow);
    }
    50% {
      box-shadow:
        0 0 0 2px var(--ring-border),
        0 0 90px -15px var(--ring-glow);
    }
  }

  .number {
    font-family: var(--font-mono);
    font-size: clamp(5rem, 14vw, 12rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ring-color);
  }

  .page.broken .number {
    animation: num-pulse 2s ease-in-out infinite;
  }

  @keyframes num-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 2vw, 1.25rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--text-muted);
    width: min(48rem, calc(100vw - 4rem));
    height: 4.2em;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 30rem) {
    .subtitle {
      height: 2.8em;
    }
  }

  @media (min-width: 48rem) {
    .subtitle {
      height: 1.4em;
    }
  }

  .last-incident {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .incident-meta {
    font-size: 0.85rem;
