    "Clippy only interrupted your work. He never summarized it.",
    "Control Panel is still hiding somewhere safe.",
  ];

  const broken = [
    "Classic Microslop.",
    "Vibe-coded, vibe-shipped, vibe-broken.",
    "Have you tried turning it off and— oh.",
    "Today's forecast: 100% chance of BSOD.",
    "Uninstall the update. You know the drill.",
    "Works on Microsoft's machines.",
    "QA said nothing. QA doesn't exist.",
    "Microslop has entered the chat.",
    "Freshly slopped, straight from Redmond.",
    "Windows Update updated the definition of 'working.'",
    "Mandatory update. Optional operating system.",
    "Your PC has encountered a Microsoft.",
    "The known issue is Windows Update.",
    "Rollback is the new upgrade.",
    "Another successful deployment to production users.",
    "The Start menu has stopped participating.",
    "Please wait while Windows uninstalls your afternoon.",
    "Some settings were harmed during this update.",
    "The fix is coming in a future broken update.",
    "Copilot summarized the crash as 'unexpected.'",
    "Clippy never stole your data. He just blocked the toolbar.",
    "Clippy never required an account to be annoying.",
    "Clippy was a paperclip, not a data pipeline.",
    "Mico changed color to BitLocker blue.",
    "Mico reacted. Your desktop didn't.",
    "Defender has identified Windows Update as a trusted threat.",
    "BitLocker recovery is the escape room nobody booked.",
    "Mico's friendly animation survived the crash.",
    "Mico is now displaying the five stages of rollback.",
    "Mico made voice conversations natural. The BSOD stayed formal.",
    "Mico would look concerned if Explorer could render it.",
    "Expressive. Customizable. Currently not responding.",
    "The update completed. Windows did not.",
    "The update was mandatory. Competence was optional.",
    "Good news: the ads still work.",
    "Error 0xQA_NOT_FOUND.",
    "Your PC has been Copiloted into a ditch.",
    "The recovery environment needs recovery.",
    "Reboot successful. Computer unavailable.",
    "Features removed successfully.",
    "Windows Recall remembers when this PC worked.",
    "Mico is expressive because support isn't.",
    "Copilot found no incidents in the provided context.",
    "AI-powered. QA-optional.",
    "Windows Update found a problem and installed it.",
    "Microsoft Defender could not defend you from Microsoft.",
    "BitLocker would like to see your paperwork.",
    "Edge is still running. Priorities.",
    "Update successful. Undoing changes.",
    "Please contact your administrator. They are already crying.",
    "The troubleshooter has detected that you need a troubleshooter.",
    "Windows restored everything except your confidence.",
    "Redmond, we have a problem. Redmond caused the problem.",
    "The Update Catalog: where automatic updates become homework.",
    "Windows has prepared a surprise restart.",
    "Telemetry successfully recorded your suffering.",
    "The optional preview was mandatory foreshadowing.",
    "System Restore has entered witness protection.",
    "Your driver has been volunteered as tribute.",
    "Microsoft Support recommends Microsoft Support.",
    "The patch notes now include your missing afternoon.",
    "Installing updates: 100%. Regretting updates: 100%.",
    "Rebooting won't save you.",
    "Your PC updated overnight. Good luck.",
    "Defender protected Windows from everything except Windows Update.",
    "Defender quarantined the symptoms. The update remains at large.",
    "BitLocker would like the 48-digit number you definitely memorized.",
    "BitLocker has converted your laptop into a very secure paperweight.",
    "Clippy sees you're trying to recover Windows. Would you like false hope?",
    "Clippy has detected a problem with your operating system. Finally, useful.",
    "Mico turned blue. So did Windows.",
    "Copilot generated a recovery key. It looks very confident.",
    "Your recovery key is in an email you deleted.",
    "Windows Hello. Windows goodbye.",
    "Your default app settings have been returned to Microsoft.",
    "The progress bar reached 100%. The problem is just getting started.",
    "The update fixed the bug that was preventing the other bug.",
    "Control Panel saw what Settings became and retired.",
    "Defender found the threat. It came through Windows Update.",
    "BitLocker secured your files from unauthorized users. You count.",
  ];

  const page = document.querySelector(".page");
  const freshlyBroken = page.classList.contains("broken");

  const shuffle = (lines) => {
    const bag = [...lines];

    // Fisher-Yates gives every ordering an equal chance, regardless of how the
    // messages happen to be arranged in this file.
    for (let i = bag.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [bag[i], bag[j]] = [bag[j], bag[i]];
    }

    return bag;
  };

  const pick = (lines, pool) => {
    const fallback = () => lines[Math.floor(Math.random() * lines.length)];

    try {
      // Keep a shuffled deck in localStorage so every line is shown once
      // before any line repeats. Including the pool size resets the deck when
      // new messages are added.
      const bagKey = `microslop-message-bag:${pool}:${lines.length}`;
      const lastKey = `microslop-message-last:${pool}`;
      const stored = JSON.parse(localStorage.getItem(bagKey) ?? "[]");
      let bag =
        Array.isArray(stored) && stored.every((line) => typeof line === "string" && lines.includes(line))
          ? stored
          : [];

      if (bag.length === 0) {
        bag = shuffle(lines);
        const last = localStorage.getItem(lastKey);

        // The end of one deck and the start of the next must not match.
        if (bag.length > 1 && bag.at(-1) === last) {
          const swapIndex = bag.findIndex((line) => line !== last);
          [bag[swapIndex], bag[bag.length - 1]] = [bag[bag.length - 1], bag[swapIndex]];
        }
      }

      const selected = bag.pop() ?? fallback();
      localStorage.setItem(bagKey, JSON.stringify(bag));
      localStorage.setItem(lastKey, selected);
      return selected;
    } catch {
      // Storage can be unavailable in strict privacy modes; random selection
      // is still a perfectly good fallback.
      return fallback();
    }
  };

  page.querySelector("[data-subtitle]").textContent =
    freshlyBroken ? pick(broken, "broken") : pick(snarky, "snarky");
  }
</script>

<style>
  .page {
