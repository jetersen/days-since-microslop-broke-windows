---
import { siteUrl } from "../links";

interface Props {
  incidentDate: string;
  lastIncidentTitle: string;
  lastIncidentDate: string;
  lastIncidentKb?: string;
}

const { incidentDate, lastIncidentTitle, lastIncidentDate, lastIncidentKb } = Astro.props;
---

<main class="page" data-incident-date={incidentDate}>
  <h1 class="title">Days Since Microslop<br />Broke Windows</h1>

  <div class="counter">
    <div class="number-ring">
      <span class="number" data-counter></span>
    </div>
  </div>

  <div class="details">
    <p class="subtitle" data-subtitle></p>

    <div class="last-incident">
      <p class="incident-meta">
        <span>Last incident:</span>
        <time>{lastIncidentDate}</time>
        {lastIncidentKb && <span class="kb">{lastIncidentKb}</span>}
      </p>
      <p class="incident-title">{lastIncidentTitle}</p>
      <a href={siteUrl("archive")} class="archive-link">
        Full history &rarr;
      </a>
    </div>
  </div>
</main>

<script>
  const snarky = [
    "A new record! Just kidding.",
    "Don't get your hopes up.",
    "Impressive, if true.",
    "The calm before the patch.",
    "Enjoy it while it lasts.",
    "Statistically unlikely to continue.",
    "Patch Tuesday is always coming.",
    "Somewhere, an intern is being blamed.",
    "Rebooting won't save you.",
    "Your PC updated overnight. Good luck.",
    "Do not read the release notes.",
    "Certified working. For now.",
    "Copilot says everything is fine.",
    "This streak was AI-generated.",
    "Now with 40% more AI per update.",
    "An AI reviewed this update. Briefly.",
    "The patch-writing AI is on vacation.",
    "Zero incidents detected. Sincerely, Copilot.",
    "Known issues: none. Trust us.",
    "Working as intended. Allegedly.",
    "It's not a bug, it's a preview feature.",
    "Quality assured by the Insider Program.",
    "Have you backed up your BitLocker key?",
    "The next KB is already downloading.",
    "Telemetry says you're enjoying this.",
    "May contain traces of quality assurance.",
    "Clippy would never have allowed this.",
    "This message was fact-checked by Copilot.",
    "Uptime is a preview feature.",
    "Insiders saw this coming. Nobody listened.",
  ];

  const broken = [
    "They did it again.",
    "Classic Microslop.",
    "Surprised? Neither are we.",
    "It was only a matter of time.",
    "Another day, another disaster.",
    "The AI wrote this patch all by itself.",
    "Copilot approved this update.",
    "Vibe-coded, vibe-shipped, vibe-broken.",
    "Have you tried turning it off and— oh.",
    "Today's forecast: 100% chance of BSOD.",
    "Uninstall the update. You know the drill.",
    "Works on Microsoft's machines.",
    "Your recovery key is in an email you deleted.",
    "QA said nothing. QA doesn't exist.",
  ];

  const page = document.querySelector<HTMLElement>(".page")!;
  const incident = new Date(page.dataset.incidentDate + "T00:00:00");
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const days = Math.max(0, Math.round((today.getTime() - incident.getTime()) / 86400000));

  // Hue: 0 (red) at 0 days → 120 (green) at 30+ days
  // Quadratic ease — stays redder longer
  const t = Math.min(days / 30, 1);
  const hue = Math.round(t * t * 120);

  // Breakage rarely makes the news same-day, so treat the first week
  // after an incident as freshly broken
  const freshlyBroken = days <= 7;

  page.style.setProperty("--hue", String(hue));
  if (freshlyBroken) page.classList.add("broken");

  const pick = (lines: string[]) => lines[Math.floor(Math.random() * lines.length)];

  page.querySelector("[data-counter]")!.textContent = String(days);
  page.querySelector("[data-subtitle]")!.textContent =
    freshlyBroken ? pick(broken) : pick(snarky);
</script>

<style>
  .page {
    --hue: 60;
    --ring-color: hsl(var(--hue) 70% 45%);
    --ring-bg: hsl(var(--hue) 60% 96%);
    --ring-glow: hsl(var(--hue) 60% 80%);
    --ring-border: hsl(var(--hue) 50% 70% / 0.25);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    flex: 1;
    padding: 2rem;
    gap: 6rem;
  }

  @media (prefers-color-scheme: dark) {
    .page {
      --ring-color: hsl(var(--hue) 75% 65%);
      --ring-bg: hsl(var(--hue) 40% 8%);
      --ring-glow: hsl(var(--hue) 50% 25%);
      --ring-border: hsl(var(--hue) 50% 40% / 0.3);
    }
  }

  .counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5rem;
  }

  .title {
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .number-ring {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(10rem, 28vw, 22rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ring-bg);
    box-shadow:
      0 0 0 1px var(--ring-border),
      0 0 80px -20px var(--ring-glow);
  }

  .page.broken .number-ring {
    animation: ring-pulse 2s ease-in-out infinite;
  }

  @keyframes ring-pulse {
    0%, 100% {
      box-shadow:
        0 0 0 1px var(--ring-border),
        0 0 40px -20px var(--ring-glow);
    }
    50% {
      box-shadow:
        0 0 0 2px var(--ring-border),
        0 0 90px -15px var(--ring-glow);
    }
  }

  .number {
    font-family: var(--font-mono);
    font-size: clamp(5rem, 14vw, 12rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ring-color);
  }

  .page.broken .number {
    animation: num-pulse 2s ease-in-out infinite;
  }

  @keyframes num-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 2vw, 1.25rem);
    font-style: italic;
    color: var(--text-muted);
  }

  .last-incident {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .incident-meta {
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.35rem;
  }

  .kb {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1;
  }

  .incident-title {
    font-weight: 600;
    color: var(--text);
    font-size: 0.95rem;
  }

  .archive-link {
    margin-top: 0.35rem;
    color: var(--color-link);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .archive-link:hover {
    text-decoration: underline;
  }
</style>
