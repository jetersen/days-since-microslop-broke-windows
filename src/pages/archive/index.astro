---
import { getCollection } from "astro:content";
import ArchiveLayout from "@/layouts/ArchiveLayout.astro";
import IncidentCard from "@/components/IncidentCard.astro";
import Footer from "@/components/Footer.astro";
import { incidentPath } from "@/lib/incidents";
import { archivePath } from "@/links";

const incidents = await getCollection("incidents");
const sorted = incidents.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const totalCount = incidents.length;
const catastrophicCount = incidents.filter(
  (i) => i.data.severity === "catastrophic"
).length;
const years = [...new Set(sorted.map((incident) => incident.data.date.getUTCFullYear()))]
  .sort((a, b) => b - a);
const title = "Broken Windows Updates: Microsoft KB Problems and Known Issues";
const description = `${totalCount} sourced Windows update incidents, including broken features, boot failures, KB problems, known issues, and Microsoft fixes.`;
const canonicalUrl = "https://microslopbroke.win/";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Microslop Broke Windows",
    alternateName: "Windows Update Wall of Shame",
    url: canonicalUrl,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    url: canonicalUrl,
    description,
    numberOfItems: totalCount,
    about: {
      "@type": "Thing",
      name: "Microsoft Windows update problems",
    },
  },
];
---

<ArchiveLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <main class="archive">
    <header class="header">
      <h1>The Windows Update<br />Wall of Shame</h1>
      <p class="tally">
        <span class="count">{totalCount}</span> incidents and counting
      </p>
      <p class="sub-tally">
        {catastrophicCount} catastrophic &middot; proudly documented
      </p>
      <p class="intro">
        A source-backed archive of Microsoft Windows updates that caused boot
        failures, broken features, driver problems, data-access issues, and
        other regressions. Open an incident for its KB number, affected
        components, fix status, and supporting sources.
      </p>
      <nav class="archive-nav" aria-label="Browse the archive">
        {years.map((year) => <a href={archivePath(`years/${year}`)}>{year}</a>)}
        <a href={archivePath("about")}>Methodology</a>
      </nav>
    </header>

    <div class="timeline">
      {sorted.map(({ id, data }) => (
        <IncidentCard
          title={data.title}
          date={data.date}
          kb={data.kb}
          severity={data.severity}
          affected={data.affected}
          fixed={data.fixed}
          fixDate={data.fixDate}
          href={incidentPath({ id, data })}
        />
      ))}
    </div>

  </main>
  <Footer currentSite="archive" />
</ArchiveLayout>

<style>
  .archive {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .tally {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .count {
    font-weight: 700;
    color: var(--color-danger);
    font-family: var(--font-mono);
  }

  .sub-tally {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .intro {
    max-width: 42rem;
    margin: 1.25rem auto 0;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .archive-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .archive-nav a {
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--color-link);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .archive-nav a:hover {
    border-color: var(--color-link);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
