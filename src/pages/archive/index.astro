---
import { getCollection, render } from "astro:content";
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";
import IncidentCard from "../../components/IncidentCard.astro";
import Footer from "../../components/Footer.astro";

const incidents = await getCollection("incidents");
const sorted = incidents.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const rendered = await Promise.all(
  sorted.map(async (incident) => {
    const { Content } = await render(incident);
    return { ...incident, Content };
  })
);

const totalCount = incidents.length;
const catastrophicCount = incidents.filter(
  (i) => i.data.severity === "catastrophic"
).length;
---

<ArchiveLayout
  title="The Windows Update Wall of Shame"
  description={`${totalCount} documented incidents of Microsoft breaking Windows through updates. ${catastrophicCount} catastrophic.`}
>
  <div class="archive">
    <header class="header">
      <h1>The Windows Update<br />Wall of Shame</h1>
      <p class="tally">
        <span class="count">{totalCount}</span> incidents and counting
      </p>
      <p class="sub-tally">
        {catastrophicCount} catastrophic &middot; proudly documented
      </p>
    </header>

    <div class="timeline">
      {rendered.map(({ id, data, body }) => (
        <IncidentCard
          id={id}
          title={data.title}
          date={data.date}
          kb={data.kb}
          severity={data.severity}
          affected={data.affected}
          fixed={data.fixed}
          fixDate={data.fixDate}
          body={body!}
        />
      ))}
    </div>

    <Footer currentSite="archive" />
  </div>
</ArchiveLayout>

<style>
  .archive {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .tally {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .count {
    font-weight: 700;
    color: var(--color-danger);
    font-family: var(--font-mono);
  }

  .sub-tally {
    font-size: 0.85rem;
    color: var(--text-muted);
    opacity: 0.7;
    margin-top: 0.25rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
