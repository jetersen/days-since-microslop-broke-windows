---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import TaxonomyIncidentList from "@/components/TaxonomyIncidentList.astro";
import ArchiveLayout from "@/layouts/ArchiveLayout.astro";
import { taxonomySlug } from "@/lib/taxonomies";

export async function getStaticPaths() {
  const incidents = await getCollection("incidents");
  const groups = new Map<
    string,
    { labels: Map<string, number>; incidents: CollectionEntry<"incidents">[] }
  >();

  for (const incident of incidents) {
    for (const label of incident.data.affected) {
      const slug = taxonomySlug(label);
      const group = groups.get(slug) ?? {
        labels: new Map<string, number>(),
        incidents: [],
      };
      group.labels.set(label, (group.labels.get(label) ?? 0) + 1);
      if (!group.incidents.some(({ id }) => id === incident.id)) {
        group.incidents.push(incident);
      }
      groups.set(slug, group);
    }
  }

  const indexableGroups = [...groups.entries()]
    .filter(([, group]) => group.incidents.length >= 3)
    .map(([slug, group]) => {
      const label = [...group.labels.entries()]
        .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))[0][0];
      return { slug, label, incidents: group.incidents };
    })
    .sort((a, b) => b.incidents.length - a.incidents.length || a.label.localeCompare(b.label));

  const componentNav = indexableGroups.map(({ slug, label, incidents }) => ({
    slug,
    label,
    count: incidents.length,
  }));

  return indexableGroups.map(({ slug, label, incidents: groupIncidents }) => ({
    params: { component: slug },
    props: {
      label,
      incidents: groupIncidents.sort(
        (a, b) => b.data.date.getTime() - a.data.date.getTime(),
      ),
      componentNav,
    },
  }));
}

interface Props {
  label: string;
  incidents: CollectionEntry<"incidents">[];
  componentNav: { slug: string; label: string; count: number }[];
}

const { label, incidents, componentNav } = Astro.props;
const years = [...new Set(incidents.map(({ data }) => data.date.getUTCFullYear()))]
  .sort((a, b) => b - a);
const kbCount = incidents.filter(({ data }) => data.kb).length;
const title = `${label} Problems Caused by Windows Updates: KB Issue Archive`;
const description = `${incidents.length} documented Windows update incidents affecting ${label}. Browse KB numbers, symptoms, dates, severity, and fix status.`;
const canonicalUrl = `https://microslopbroke.win/affected/${Astro.params.component}/`;
---

<ArchiveLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <main class="landing">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Archive</a><span aria-hidden="true">/</span><span>Affected</span>
      <span aria-hidden="true">/</span><span>{label}</span>
    </nav>

    <header>
      <p class="eyebrow">Affected Windows component</p>
      <h1>{label} Problems Caused by Windows Updates</h1>
      <p class="intro">
        The archive contains <strong>{incidents.length} documented Windows update
        incidents affecting {label}</strong>. Browse the timeline below for symptoms,
        severity, source-backed details, and whether Microsoft shipped a fix.
      </p>
      <p class="summary">
        {kbCount} entries with KB numbers · reported across {years.length} {years.length === 1 ? "year" : "years"}
      </p>
    </header>

    <section class="year-nav" aria-labelledby="year-heading">
      <h2 id="year-heading">Browse those years</h2>
      <nav aria-label={`Years with ${label} incidents`}>
        {years.map((year) => <a href={`/years/${year}/`}>{year}</a>)}
      </nav>
    </section>

    <section aria-labelledby="incidents-heading">
      <h2 id="incidents-heading" class="section-title">{label} incident timeline</h2>
      <TaxonomyIncidentList
        incidents={incidents}
        linkedAffected={componentNav.map(({ slug }) => slug)}
      />
    </section>

    <section class="browse-components" aria-labelledby="components-heading">
      <h2 id="components-heading">Browse other frequently affected components</h2>
      <ul>
        {componentNav.map((component) => (
          <li>
            <a
              href={`/affected/${component.slug}/`}
              aria-current={component.label === label ? "page" : undefined}
            >
              {component.label} <span>{component.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer currentSite="archive" />
</ArchiveLayout>

<style>
  .landing {
    max-width: 52rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  a {
    color: var(--color-link);
  }

  header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin-bottom: 0.5rem;
    color: var(--color-danger);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    line-height: 1.15;
  }

  .intro {
    max-width: 47rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-family: var(--font-sans);
    line-height: 1.7;
  }

  .summary {
    margin-top: 0.8rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .year-nav {
    margin: 1.5rem 0 2.5rem;
  }

  .year-nav h2,
  .section-title,
  .browse-components h2 {
    margin-bottom: 0.85rem;
    font-size: 1rem;
  }

  .year-nav nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .year-nav a,
  .browse-components a {
    display: inline-flex;
    gap: 0.45rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--text-muted);
    font-size: 0.76rem;
    text-decoration: none;
  }

  .year-nav a:hover,
  .browse-components a:hover,
  .browse-components a[aria-current="page"] {
    border-color: var(--color-link);
    color: var(--color-link);
  }

  .browse-components {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .browse-components ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .browse-components span {
    color: var(--text);
    font-weight: 700;
  }
</style>
