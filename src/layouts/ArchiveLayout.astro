---
import "@/styles/global.css";
import SeoHead from "@/components/SeoHead.astro";

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalUrl = "https://microslopbroke.win/",
  image = "https://microslopbroke.win/images/social-card.png",
  ogType = "website",
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      siteName="Microslop Broke Windows"
      sitemapPath="/sitemap-index.xml"
      imageUrl={image}
      ogType={ogType}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  body {
    font-family: var(--font-mono);
    background: var(--bg);
    color: var(--text);
    min-height: 100dvh;
  }
</style>
