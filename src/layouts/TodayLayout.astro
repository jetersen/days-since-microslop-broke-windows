---
import "@/styles/global.css";
import SeoHead from "@/components/SeoHead.astro";

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalUrl = "https://didmicroslopbreakwindows.today/",
  jsonLd,
} = Astro.props;
const image = "https://didmicroslopbreakwindows.today/images/social-card.png";
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      siteName="Did Microslop Break Windows Today?"
      sitemapPath="/sitemap.xml"
      imageUrl={image}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  body {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--text);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
  }
</style>
